---
import mascotImg from '../assets/jihoo-no-bg.png';

const quips = [
  "hello!",
  "boo!",
  "have you tried NixOS btw",
  "the ai agent wrote this line, not me",
  "segfault? never heard of her",
  "noctalia shell looking clean today",
  "rawr x3",
  "nyaa~",
  "uwu",
  "hehe :3",
  "peekaboo!",
  "go read that HoTT book already",
];

const projects = [
  {
    name: "Kamo",
    href: "https://github.com/jihoo12/kamo",
    eyebrow: "proof assistant · Rust",
    description:
      "An experimental Cartesian cubical proof-assistant kernel with explicit S-expressions, checked univalence examples, resource limits, and a small Rust library API.",
    tags: ["cubical type theory", "kernel", "Rust"],
    tone: "c4",
  },
  {
    name: "kaguyaOS",
    href: "https://github.com/jihoo12/kaguyaos",
    eyebrow: "operating system · Rust",
    description:
      "A hobby x86_64 UEFI OS with Ring 0/3 isolation, preemptive scheduling, SMP, a custom executable format, FAT16, USB/NVMe/E1000 drivers, and a userspace shell.",
    tags: ["x86_64", "UEFI", "kernel"],
    tone: "c1",
  },
  {
    name: "shady",
    href: "https://github.com/jihoo12/shady",
    eyebrow: "3D Wayland compositor · C",
    description:
      "An experimental wlroots compositor where normal Wayland windows become textured 3D objects you can tilt, ray-pick, carry, throw, and navigate around in first person.",
    tags: ["Wayland", "wlroots", "GLES2"],
    tone: "c5",
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="-XugzPp_Zk_0xP3B20_EYYY-9wI07ZA4CFNkDe27ITY" />
  <title>jihoo — systems, type theory, weird desktops</title>
  <meta name="description" content="Jihoo's corner of the internet — Rust, operating systems, proof assistants, Wayland experiments, compilers, and NixOS." />
  <link rel="canonical" href="https://jihoo.pages.dev/" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="jihoo — systems, type theory, weird desktops" />
  <meta property="og:description" content="Rust, operating systems, proof assistants, Wayland experiments, compilers, and NixOS." />
  <meta property="og:url" content="https://jihoo.pages.dev/" />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Jihoo",
    url: "https://jihoo.pages.dev/",
    sameAs: ["https://github.com/jihoo12"],
    knowsAbout: ["Rust", "Operating systems", "Compilers", "Cubical type theory", "Wayland", "NixOS"]
  })} />
  <link rel="icon" type="image/png" href="/jihoo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <main class="wrap">
    <header class="hero">
      <p class="crt-line">jihoo<span class="dim">@</span>dev<span class="accent">:~$</span> <span class="caret">▍</span></p>
      <h1>Hi, I'm <span class="accent c1">Jihoo</span>.</h1>
      <p class="tagline">Systems code, type theory, and interfaces that probably should not exist.</p>
      <nav class="jump" aria-label="Page links">
        <a href="#about">about</a>
        <span>/</span>
        <a href="#projects">projects</a>
        <span>/</span>
        <a href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">github ↗</a>
      </nav>
    </header>

    <section class="bio" id="about">
      <p>I'm <span class="accent c2">Jihoo</span> — an undergraduate who lives and breathes systems-level code. I mostly work in <span class="accent c3">Rust</span>, <span class="accent c4">C++</span>, and <span class="accent c5">C</span>, and I'm happiest when I'm building kernels, language tooling, or strange low-level experiments.</p>
      <p>My day-to-day setup is <span class="accent c2">NixOS</span> on both desktop and laptop. Nix is more than a package manager to me; it's how I think about reproducibility and system design. I'm also fascinated by <span class="accent c1">compilers</span>, <span class="accent c2">AI agents</span>, <span class="accent c3">Lisp</span>, and <span class="accent c4">cubical type theory</span> — especially the point where type theory, homotopy, and implementation details collide.</p>
      <p>I reach for an AI agent constantly while coding. Somewhere nearby there is usually a HoTT, cubical type theory, or category theory PDF that I am definitely about to read.</p>
    </section>

    <section class="projects" id="projects">
      <div class="section-head">
        <p class="section-kicker">selected work</p>
        <h2>Things I'm building</h2>
        <p>Three projects that best describe what I'm currently curious about.</p>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={"/projects/" + project.href.split("/").pop() + "/"}>
            <div class="project-topline">
              <span class:list={["project-dot", project.tone]} aria-hidden="true"></span>
              <span>{project.eyebrow}</span>
            </div>
            <h3>{project.name}<span aria-hidden="true"> ↗</span></h3>
            <p>{project.description}</p>
            <div class="tags">
              {project.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>

      <p class="project-more">
        More experiments live in <a class="link" href="https://github.com/jihoo12?tab=repositories" target="_blank" rel="noopener noreferrer">my GitHub repositories</a>.
      </p>
    </section>

    <footer class="foot">
      <p class="crt-line dim">jihoo@dev<span class="accent">:~$</span> <span class="caret">▍</span></p>
    </footer>
  </main>

  <div id="mascot" class="mascot" role="button" tabindex="0" aria-label="A small penguin-jacket character. Click before it runs off.">
    <div id="mascot-bubble" class="bubble"></div>
    <img src={mascotImg.src} alt="" draggable="false" />
  </div>

  <script define:vars={{ quips }}>
    const mascot = document.getElementById('mascot');
    const bubble = document.getElementById('mascot-bubble');
    let retreatTimer = null;
    let hasFled = false;

    function rand(min, max) {
      return Math.random() * (max - min) + min;
    }

    function pickQuip() {
      return quips[Math.floor(Math.random() * quips.length)];
    }

    function reset(instant) {
      mascot.style.transition = instant ? 'none' : '';
      mascot.style.opacity = '0';
      mascot.style.pointerEvents = 'none';
      mascot.style.right = '-180px';
    }

    function scheduleNext(delayMs) {
      clearTimeout(retreatTimer);
      const delay = delayMs !== undefined ? delayMs : rand(9000, 22000);
      setTimeout(popIn, delay);
    }

    function popIn() {
      reset(true);
      void mascot.offsetWidth;
      mascot.style.transition =
        'right .6s cubic-bezier(.34,1.56,.64,1), opacity .3s ease';
      bubble.textContent = pickQuip();
      requestAnimationFrame(() => {
        mascot.style.opacity = '1';
        mascot.style.pointerEvents = 'auto';
        mascot.style.right = '14px';
        bubble.classList.add('show');
      });
      retreatTimer = setTimeout(() => retreat(), rand(3800, 5200));
    }

    function retreat() {
      bubble.classList.remove('show');
      mascot.style.transition = 'right .5s ease-in, opacity .5s ease';
      mascot.style.right = '-180px';
      mascot.style.opacity = '0';
      setTimeout(() => {
        mascot.style.pointerEvents = 'none';
        scheduleNext();
      }, 550);
    }

    function flee() {
      clearTimeout(retreatTimer);
      bubble.classList.remove('show');
      mascot.style.transition =
        'right .7s cubic-bezier(.55,-0.4,.7,.3), opacity .6s ease .1s';
      mascot.style.right = 'calc(100vw + 40px)';
      mascot.style.opacity = '0';
      hasFled = true;
      setTimeout(() => {
        mascot.style.pointerEvents = 'none';
        reset(true);
        void mascot.offsetWidth;
        scheduleNext(hasFled ? rand(14000, 30000) : undefined);
      }, 750);
    }

    mascot.addEventListener('click', flee);
    mascot.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        flee();
      }
    });

    reset(true);
    scheduleNext(rand(2500, 6000));
  </script>

  <style>
    :root {
      --bg: #faf5ea;
      --panel: rgba(255, 255, 255, 0.72);
      --border: #e7d7bc;
      --text: #2c2a25;
      --dim: #8a8270;
      --rust: #e2692f;
      --blue: #3b7dc9;
      --c1: #e2692f;
      --c2: #d63e83;
      --c3: #3b7dc9;
      --c4: #1f9e79;
      --c5: #8452c9;
      --shadow: 0 18px 50px rgba(74, 62, 42, 0.08);
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
    }

    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'IBM Plex Mono', monospace;
      overflow-x: hidden;
    }

    body {
      background-image:
        radial-gradient(circle at 10% 0%, rgba(226,105,47,0.14), transparent 40%),
        radial-gradient(circle at 90% 10%, rgba(59,125,201,0.12), transparent 45%),
        radial-gradient(circle at 20% 90%, rgba(31,158,121,0.10), transparent 40%),
        radial-gradient(circle at 85% 85%, rgba(214,62,131,0.10), transparent 42%);
      min-height: 100vh;
    }

    .wrap {
      max-width: 860px;
      margin: 0 auto;
      padding: 64px 24px 40px;
    }

    .hero { margin-bottom: 48px; }

    .crt-line {
      font-size: 0.9rem;
      color: var(--dim);
      margin: 0 0 18px;
      letter-spacing: 0.02em;
    }

    .crt-line.dim { margin-top: 0; }

    .caret {
      display: inline-block;
      color: var(--rust);
      animation: blink 1.1s steps(1) infinite;
    }

    @keyframes blink { 50% { opacity: 0; } }

    h1, h2, h3 {
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: -0.02em;
    }

    h1 {
      font-weight: 800;
      font-size: clamp(2.2rem, 6vw, 3.5rem);
      line-height: 1.05;
      margin: 0 0 14px;
    }

    h2 {
      margin: 0;
      font-size: clamp(1.7rem, 4vw, 2.3rem);
    }

    h3 {
      margin: 0;
      font-size: 1.25rem;
    }

    .accent { color: var(--rust); font-weight: 600; }
    .accent.c1, .project-dot.c1 { color: var(--c1); }
    .accent.c2, .project-dot.c2 { color: var(--c2); }
    .accent.c3, .project-dot.c3 { color: var(--c3); }
    .accent.c4, .project-dot.c4 { color: var(--c4); }
    .accent.c5, .project-dot.c5 { color: var(--c5); }

    .tagline {
      color: var(--dim);
      font-size: 1.08rem;
      margin: 0;
      max-width: 56ch;
      line-height: 1.65;
    }

    .jump {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 22px;
      font-size: 0.87rem;
      color: var(--dim);
    }

    .jump a {
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px dashed var(--border);
    }

    .jump a:hover {
      color: var(--c2);
      border-color: var(--c2);
    }

    .bio {
      max-width: 66ch;
      line-height: 1.8;
      font-size: 1.02rem;
      color: var(--text);
      margin-bottom: 62px;
    }

    .bio p { margin: 0 0 16px; }

    .link {
      color: var(--blue);
      text-decoration: none;
      border-bottom: 1px dashed var(--blue);
    }

    .link:hover {
      color: var(--c2);
      border-bottom-color: var(--c2);
    }

    .projects {
      scroll-margin-top: 28px;
    }

    .section-head {
      display: grid;
      gap: 8px;
      margin-bottom: 22px;
    }

    .section-head > p:last-child {
      margin: 0;
      color: var(--dim);
      line-height: 1.65;
      max-width: 58ch;
    }

    .section-kicker {
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.72rem;
      color: var(--c4);
      font-weight: 700;
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .project-card {
      display: flex;
      flex-direction: column;
      min-height: 270px;
      padding: 18px;
      color: var(--text);
      text-decoration: none;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--panel);
      box-shadow: var(--shadow);
      backdrop-filter: blur(10px);
      transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }

    .project-card:hover {
      transform: translateY(-4px);
      border-color: #ceb995;
      box-shadow: 0 22px 58px rgba(74, 62, 42, 0.13);
    }

    .project-topline {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 28px;
      color: var(--dim);
      font-size: 0.72rem;
      line-height: 1.4;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .project-dot {
      width: 8px;
      height: 8px;
      flex: 0 0 auto;
      border-radius: 50%;
      background: currentColor;
    }

    .project-card > p {
      color: var(--dim);
      line-height: 1.65;
      font-size: 0.9rem;
      margin: 12px 0 20px;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: auto;
    }

    .tags span {
      border: 1px solid var(--border);
      background: rgba(250, 245, 234, 0.72);
      border-radius: 999px;
      padding: 5px 8px;
      color: #6f6859;
      font-size: 0.72rem;
    }

    .project-more {
      margin: 18px 0 0;
      color: var(--dim);
      font-size: 0.9rem;
    }

    .foot { margin-top: 56px; }

    .mascot {
      position: fixed;
      bottom: 0;
      width: 150px;
      z-index: 200;
      opacity: 0;
      cursor: pointer;
      pointer-events: none;
      animation: bob 2.4s ease-in-out infinite;
    }

    .mascot img {
      display: block;
      width: 100%;
      height: auto;
      filter: drop-shadow(0 14px 16px rgba(44,42,37,0.22));
      user-select: none;
      -webkit-user-drag: none;
    }

    @keyframes bob {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    .bubble {
      position: absolute;
      top: -6px;
      left: 50%;
      transform: translate(-50%, -100%);
      background: #fff;
      border: 1px solid var(--rust);
      color: var(--text);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      line-height: 1.4;
      padding: 8px 10px;
      border-radius: 8px;
      width: 190px;
      max-width: 58vw;
      text-align: center;
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
    }

    .bubble.show { opacity: 1; }

    .bubble::after {
      content: "";
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 10px;
      height: 10px;
      background: #fff;
      border-right: 1px solid var(--rust);
      border-bottom: 1px solid var(--rust);
      rotate: 45deg;
    }

    @media (max-width: 760px) {
      .wrap { padding-top: 42px; }
      .project-grid { grid-template-columns: 1fr; }
      .project-card { min-height: 0; }
      .project-topline { margin-bottom: 18px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .mascot { animation: none; }
      .mascot, .bubble, .project-card { transition: none !important; }
    }
  </style>
</body>
</html>
